{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell",
      "Read",
      "Grep",
      "Glob",
      "Bash(./mvnw *)",
      "Bash(mvn *)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(ng test *)",
      "Bash(ng build *)",
      "Bash(git *)",
      "Bash(docker compose *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(xargs *)",
      "Bash(ls *)",
      "Bash(echo *)",
      "Edit",
      "Write",
      "Bash(npx *)",
      "Bash(cd *)",
      "Bash(cp *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(mkdir *)",
      "Bash(rmdir *)",
      "Bash(sort *)",
      "Bash(docker info*)",
      "Bash(docker version*)",
      "Bash(docker ps*)",
      "Bash(claude *)",
      "Bash(cmd /c mklink *)",
      "Bash(cmd /c rmdir *)"
    ],
    "deny": [
      "PowerShell(git push)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "PowerShell(git push *)",
      "PowerShell(git rebase *)",
      "PowerShell(git reset --hard *)",
      "Read(/governance/resume/**)",
      "Edit(/governance/resume/**)",
      "Read(**/.idea/**)",
      "Read(**/.obsidian/**)",
      "Read(/governance/**/*.png)",
      "Read(/governance/**/*.pdf)"
    ],
    "defaultMode": "acceptEdits"
  },
  "enabledPlugins": {
    "fabrica-de-software@desenvolvimento-corporativo": true
  },
  "agent": "fabrica-de-software:gerente"
}
