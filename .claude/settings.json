{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell",
      "Read",
      "Grep",
      "Glob",
      "Bash(./mvnw *)",
      "Bash(mvn *)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(ng test *)",
      "Bash(ng build *)",
      "Bash(git *)",
      "Bash(docker compose *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(xargs *)",
      "Bash(ls *)",
      "Bash(echo *)",
      "Edit",
      "Write",
      "Bash(npx *)",
      "Bash(cd *)",
      "Bash(cp *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(mkdir *)",
      "Bash(rmdir *)",
      "Bash(sort *)",
      "Bash(docker info*)",
      "Bash(docker version*)",
      "Bash(docker ps*)",
      "Bash(claude *)",
      "Bash(cmd /c mklink *)",
      "Bash(cmd /c rmdir *)",
      "mcp__plugin_fabrica-de-software_atlassian__atlassianUserInfo",
      "mcp__plugin_fabrica-de-software_atlassian__getAccessibleAtlassianResources",
      "mcp__plugin_fabrica-de-software_atlassian__discover",
      "mcp__plugin_fabrica-de-software_atlassian__executeRead",
      "mcp__plugin_fabrica-de-software_atlassian__getJiraIssue",
      "mcp__plugin_fabrica-de-software_atlassian__searchJiraIssuesUsingJql",
      "mcp__plugin_fabrica-de-software_atlassian__listJiraIssueComments",
      "mcp__plugin_fabrica-de-software_atlassian__createJiraIssue",
      "mcp__plugin_fabrica-de-software_atlassian__editJiraIssue",
      "mcp__plugin_fabrica-de-software_atlassian__addOrEditJiraIssueComment",
      "mcp__plugin_fabrica-de-software_atlassian__executeWrite",
      "mcp__GitLab__save_merge_request",
      "mcp__GitLab__get_merge_request",
      "mcp__GitLab__list_merge_requests"
    ],
    "deny": [
      "Bash(git rebase *)",
      "Bash(git reset --hard *)",
      "PowerShell(git rebase *)",
      "PowerShell(git reset --hard *)",
      "Read(/governance/resume/**)",
      "Edit(/governance/resume/**)",
      "Read(**/.idea/**)",
      "Read(**/.obsidian/**)",
      "Read(/governance/**/*.png)",
      "Read(/governance/**/*.pdf)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push * main*)",
      "Bash(git push * master*)",
      "Bash(git push * develop*)",
      "Bash(git push * *:main*)",
      "Bash(git push * *:master*)",
      "Bash(git push * *:develop*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push --delete*)",
      "PowerShell(git push * --delete*)",
      "PowerShell(git push -d *)",
      "PowerShell(git push * -d *)",
      "PowerShell(git push --mirror*)",
      "PowerShell(git push * --mirror*)",
      "PowerShell(git push * main*)",
      "PowerShell(git push * master*)",
      "PowerShell(git push * develop*)",
      "PowerShell(git push * *:main*)",
      "PowerShell(git push * *:master*)",
      "PowerShell(git push * *:develop*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "enabledPlugins": {
    "fabrica-de-software@desenvolvimento-corporativo": true
  },
  "agent": "fabrica-de-software:gerente"
}
